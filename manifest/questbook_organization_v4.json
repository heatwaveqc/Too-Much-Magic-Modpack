  "policy": {
    "mod_coverage": "all_enabled_mods_listed_in_at_least_one_quest_section_or_technical_credits",
    "crossmod_edges": "both_directions_with_versioned_evidence",
    "rare_completionist": "optional_achievements_last",
    "fish_catch_per_species": 5,
    "fish_capstone_reward_candidate": "apotheosis:godforged_pearl",
    "first_person_kills": "native_kill_tasks_if_verified",
    "mob_ladder_default_proposal": [
      5,
      10,
      50,
      100
    ],
    "forbidden_proxy": [
      "catch_via_inventory",
      "eat_via_inventory",
      "learn_via_item",
      "kill_via_drop"
    ],
    "preserve_existing_claim_ids": true,
    "category_types": {
      "Informational": {
        "structure": "browsable_topic_cards_short_minimal_task_gates",
        "examples": [
          "Welcome to Too Much Magic",
          "Getting Started",
          "Tips & Tricks"
        ]
      },
      "Regular Progress": {
        "structure": "one_crossmod_survival_to_endgame_progression_spine_with_specialist_links",
        "examples": [
          "Basic Progression",
          "Advanced Progression",
          "Paths & Transformations"
        ]
      },
      "Mod-Focused": {
        "structure": "one_core_tier_or_ritual_mainline_with_hardest_significant_mod_capstone_and_parallel_utility_addon_and_bidirectional_compat_branches",
        "examples": [
          "Theurgy",
          "Occultism",
          "Draconic Evolution",
          "ProjectE"
        ]
      },
      "Thematic": {
        "structure": "multi_mod_non_linear_activity_families_and_ladders_not_full_catalog_completion",
        "examples": [
          "Food",
          "Fishing",
          "Mob Hunts",
          "Alcohol is Magic"
        ]
      },
      "Challenge": {
        "structure": "optional_one_time_completionist_feats_plus_distinct_native_repeatable_bountiful_contracts",
        "examples": [
          "Master Angler",
          "Master Chef",
          "Bestiary",
          "Bounties & Contracts"
        ]
      }
    },
    "mod_focused_capstone": "hardest_or_most_significant_native_craft_ritual_or_intentional_tmm_crossmod_endgate_not_merely_highest_cost",
    "mod_focused_side_branch_types": [
      "useful_items_and_tools",
      "addons",
      "cross_mod_compatibility"
    ],
    "tmm_specific_crossmod_capstone_examples": [
      {
        "chapter": "Occultism",
        "target": "ProjectE Philosopher's Stone",
        "status": "owner_proposed_design",
        "distinction": "explicit_TMM_crossover_capstone_not_native_Occultism_item",
        "note": "Preserve high-tier Eldritch Ancient Miner as native pinnacle and ProjectE/boss-token gating as independently enforced"
      }
    ],
    "bounty_contracts": "Challenge group under Bounties & Contracts; repeatable gameplay runs inside Bountiful, not FTB possession pseudo-bounties",
    "global_completionist_only_under_challenge": true
  },
  "not_in_scope": [
    "new_gameplay_mechanics",
    "runtime_quest_rewrite",
    "new_licenses_or_mod_pins",
    "full_build_authorization"
  ]
