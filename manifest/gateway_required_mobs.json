  "group": "B19",
  "description": "One controlled, craftable standard Gate Pearl per eligible progression-relevant hostile in the initial Ars Nouveau and Iron's cohort. Extend via source-audited dependency mob roster. This is not yet exhaustive across every installed magic mod.",
  "recipe": {
    "pattern": [
      " C ",
      "SMS",
      " E "
    ],
    "iron": "minecraft:iron_ingot",
    "ender_pearl": "minecraft:ender_pearl",
    "magic_token": {
      "ars": "ars_nouveau:source_gem",
      "irons": "irons_spellbooks:arcane_essence"
    },
    "note": "C is each target's unique vanilla catalyst. One craft produces one bound Gate Pearl. No alternative catalyst overlap within this pilot."
  },
  "policy": {
    "primary_aim": "repeatable access to progression-relevant nonboss mobs, not replacement for unique dungeon/boss gating",
    "wave_count": 3,
    "no_extra_mob_loot": true,
    "completion_vanilla_xp_only": true,
    "spawned_mob_normal_drops": "must verify in game",
    "mob_farm_automation": "allowed; no player-only-damage constraint",
    "no_environmental_failure_explosions": true,
    "native_boss_and_friendly_npc_exclusions": [
      "ars_nouveau:wilden_boss",
      "irons_spellbooks:dead_king",
      "irons_spellbooks:fire_boss",
      "irons_spellbooks:priest",
      "minecraft:wandering_trader"
    ],
    "future_audit": "Check pinned JAR entity registries, required mob-only drops, mob spawning route and recipe usage across every magic mod; expand catalog only after validation."
  },
