      "irons_spellbooks:dead_king",
      "irons_spellbooks:fire_boss",
      "irons_spellbooks:priest",
      "minecraft:wandering_trader"
    ],
    "future_audit": "Check pinned JAR entity registries, required mob-only drops, mob spawning route and recipe usage across every magic mod; expand catalog only after validation.",
    "friendly_mob_policy": "For rare naturally spawning utility creatures, award the living creature upon completion of combat waves; never require killing a friendly creature.",
    "completion_reward_exceptions": "Five Iron's encounters award parchment fragments only on successful completion in addition to vanilla XP. Existing friendly-mob summon rewards unchanged."
  },
