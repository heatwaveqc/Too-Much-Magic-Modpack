# Claimable one-time personal TMM starter supplies, invoked by Tips & Tricks.
# The tmm:starter_kit advancement is a LEGACY marker for old first-login automatic
# Tome + steaks. Do not double-grant those items on existing test-world players.
# Newly created profiles do not earn that legacy impossible advancement.
# The separate tmm:starter_kit_claimed advancement makes this function idempotent.
execute unless entity @s[advancements={tmm:starter_kit_claimed=true}] unless entity @s[advancements={tmm:starter_kit=true}] run give @s akashictome:tome[akashictome:tool_content=[{id:"ars_nouveau:worn_notebook",count:1,components:{"akashictome:defined_mod":"ars_nouveau"}},{id:"botania:lexicon",count:1,components:{"akashictome:defined_mod":"botania"}},{id:"occultism:dictionary_of_spirits",count:1,components:{"akashictome:defined_mod":"occultism"}},{id:"evilcraft:origins_of_darkness",count:1,components:{"akashictome:defined_mod":"evilcraft"}},{id:"rootsclassic:runic_tablet",count:1,components:{"akashictome:defined_mod":"rootsclassic"}},{id:"hexerei:book_of_shadows",count:1,components:{"akashictome:defined_mod":"hexerei"}},{id:"modonomicon:modonomicon",count:1,components:{"akashictome:defined_mod":"theurgy","modonomicon:book_id":"theurgy:the_hermetica"}},{id:"patchouli:guide_book",count:1,components:{"akashictome:defined_mod":"goety","patchouli:book":"goety:black_book"}},{id:"eidolon_repraised:codex",count:1,components:{"akashictome:defined_mod":"eidolon_repraised"}},{id:"neovitae:guide_book",count:1,components:{"akashictome:defined_mod":"neovitae"}},{id:"astralsorcery:tome",count:1,components:{"akashictome:defined_mod":"astralsorcery"}}]] 1
execute unless entity @s[advancements={tmm:starter_kit_claimed=true}] unless entity @s[advancements={tmm:starter_kit=true}] run give @s minecraft:cooked_beef 2
execute unless entity @s[advancements={tmm:starter_kit_claimed=true}] run give @s comforts:sleeping_bag_white 1
advancement grant @s only tmm:starter_kit_claimed
